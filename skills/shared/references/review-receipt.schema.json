{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-dev.review-receipt/v2",
  "title": "Independent review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "issue", "base", "head", "tree", "diff_sha256",
    "process_check_review_sha256", "report_sha256", "verdict", "findings",
    "semantic_closures", "total_files", "reviewed_files", "skipped_files", "coverage", "round",
    "previous_receipt", "implementer", "reviewer", "trust", "attestation",
    "host_verification", "artifacts", "created_at"
  ],
  "properties": {
    "schema": {"const": "agent-dev.review-receipt/v2"},
    "issue": {"type": "string", "minLength": 1},
    "base": {"type": "string", "format": "git-sha"},
    "head": {"type": "string", "format": "git-sha"},
    "tree": {"type": "string", "format": "git-sha"},
    "diff_sha256": {"type": "string", "format": "sha256"},
    "process_check_review_sha256": {"type": "string", "format": "sha256"},
    "report_sha256": {"type": "string", "format": "sha256"},
    "verdict": {"enum": ["pass", "pass-with-notes", "blocked"]},
    "findings": {"type": "array", "items": {"$ref": "#/definitions/finding"}},
    "semantic_closures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "dod_id", "spec_anchor", "mapping_sha256", "status", "note"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "dod_id": {"type": "string", "minLength": 1},
          "spec_anchor": {"type": "string", "minLength": 1},
          "mapping_sha256": {"type": "string", "format": "sha256"},
          "status": {"const": "closed"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "total_files": {"type": "integer", "minimum": 0},
    "reviewed_files": {"type": "integer", "minimum": 0},
    "skipped_files": {"type": "integer", "minimum": 0},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_sha256", "files"],
      "properties": {
        "preview_sha256": {"type": "string", "format": "sha256"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status", "reason"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "status": {"enum": ["reviewed", "skipped"]},
              "reason": {"type": "string"}
            }
          },
          "uniqueItems": true
        }
      }
    },
    "round": {"type": "integer", "minimum": 1},
    "previous_receipt": {
      "anyOf": [{"type": "null"}, {"$ref": "#/definitions/artifact"}]
    },
    "implementer": {"$ref": "#/definitions/identity"},
    "reviewer": {"$ref": "#/definitions/identity"},
    "trust": {"enum": ["host-verified", "operator-attested"]},
    "attestation": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "statement", "confirmed_at"],
          "properties": {
            "operator": {"type": "string", "minLength": 1},
            "statement": {"type": "string", "minLength": 1},
            "confirmed_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "host_verification": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verified", "host", "session", "proof", "proof_sha256"],
          "properties": {
            "verified": {"const": true},
            "host": {"type": "string", "minLength": 1},
            "session": {"type": "string", "minLength": 1},
            "proof": {"type": "string", "minLength": 1},
            "proof_sha256": {"type": "string", "format": "sha256"}
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "process_check_review", "coverage_preview"],
      "properties": {
        "report": {"$ref": "#/definitions/artifact"},
        "process_check_review": {"$ref": "#/definitions/artifact"},
        "coverage_preview": {"$ref": "#/definitions/artifact"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "format": "sha256"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "agent", "session", "model", "effort", "role"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "session": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "role": {"enum": ["development", "supervisor", "review"]},
        "tier": {"enum": ["default", "escalated"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status", "location", "message", "closure"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "status": {"enum": ["open", "closed"]},
        "location": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "closure": {"type": "string"}
      }
    }
  }
}
