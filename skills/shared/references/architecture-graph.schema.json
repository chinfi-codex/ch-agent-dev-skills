{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pandu.architecture-graph/v2",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"
    },
    "sha256": {
      "type": "string",
      "format": "sha256",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "format": "git-sha",
      "pattern": "^[0-9a-f]{40}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "line": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "calls",
            "depends_on",
            "implements",
            "extends",
            "uses",
            "exposes",
            "contains",
            "constrains",
            "emits",
            "consumes",
            "reads",
            "writes"
          ]
        },
        "target": {"$ref": "#/definitions/id"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code",
            "test",
            "spec",
            "decision",
            "release",
            "command",
            "legacy",
            "cutover",
            "other"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "uri": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "sha256": {"$ref": "#/definitions/sha256"},
        "commit": {"$ref": "#/definitions/gitSha"},
        "tree": {"$ref": "#/definitions/gitSha"}
      },
      "oneOf": [
        {"required": ["path", "sha256"]},
        {"required": ["uri"]}
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "module",
        "responsibility",
        "kind",
        "name",
        "status",
        "source",
        "verification",
        "evidence",
        "last_verified",
        "last_verified_version",
        "verified_commit",
        "relations",
        "supersedes"
      ],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "module": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["module", "interface", "constraint"]},
        "name": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["current", "release_only", "superseded", "retired", "needs_verification"]
        },
        "version": {"type": ["string", "null"]},
        "applies_to": {
          "type": ["array", "null"],
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source": {"$ref": "#/definitions/source"},
        "verification": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/definitions/evidence"},
          "minItems": 1
        },
        "last_verified": {
          "type": ["string", "null"],
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "last_verified_version": {"type": "string", "minLength": 1},
        "verified_commit": {
          "type": ["string", "null"],
          "format": "git-sha",
          "pattern": "^[0-9a-f]{40}$"
        },
        "relations": {
          "type": "array",
          "items": {"$ref": "#/definitions/relation"},
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": {"$ref": "#/definitions/id"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "records"],
  "properties": {
    "schema": {"const": "pandu.architecture-graph/v2"},
    "module": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "baseline": {
      "type": "object",
      "required": ["spec_baseline_date"],
      "properties": {
        "spec_baseline_date": {"$ref": "#/definitions/date"}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/definitions/record"}
    }
  },
  "additionalProperties": false
}
