{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pandu.architecture-graph/v1",
  "type": "object",
  "required": [
    "schema",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "pandu.architecture-graph/v1"
    },
    "module": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "baseline": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "module",
          "responsibility",
          "kind",
          "name",
          "status",
          "source",
          "verification",
          "evidence",
          "last_verified",
          "last_verified_version",
          "relations",
          "supersedes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "current",
              "release_only",
              "superseded",
              "retired",
              "needs_verification",
              "legacy"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "applies_to": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": true
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "last_verified": {
            "type": "string",
            "minLength": 1
          },
          "last_verified_version": {
            "type": "string",
            "minLength": 1
          },
          "verified_commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "target"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
